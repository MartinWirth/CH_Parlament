# CH_Parlament environment configuration
# Values below reflect application defaults. Copy to .env and set secrets locally.
# NOTE: Python does not automatically load .env files; load/export them in your
# process manager or shell before starting the application.

# Parliament OData service
PARLIAMENT_API=https://ws.parlament.ch/odata.svc

# Admin authentication: unset/empty by default (no usable credentials)
ADMIN_REFRESH_PASSWORD=
SOCIAL_REFRESH_TOKEN=

# Automatic social checks: disabled by default
SOCIAL_CHECK_INTERVAL_HOURS=0
SOCIAL_CHECK_LANGUAGES=DE
SOCIAL_CHECK_HISTORY_PATH=.social_check_history.sqlite3

# External personal/party page scanning: disabled by default.
# Use 1 to enable; "true" does NOT enable the scanner.
ENABLE_EXTERNAL_HOMEPAGE_SCAN=0
SOCIAL_HOMEPAGE_TTL_HOURS=24

# Snapshot and response caches
SOCIAL_CACHE_PATH=.social_profiles_cache.json
SOCIAL_SNAPSHOT_PATH=.social_profiles_snapshot.json
HTTP_RESPONSE_CACHE_PATH=.http_response_cache.json

# Sources and manual review
PARTY_PROFILE_SOURCES=party_profile_sources.json
SOCIAL_REGIONAL_PARTY_SOURCES_PATH=social_regional_party_sources.json
SOCIAL_REVIEW_CANDIDATES_PATH=social_review_candidates.json
SOCIAL_REVIEW_DECISIONS_PATH=.social_review_decisions.json
# PARTY_PROFILE_SOURCES=party_profile_sources.json
# SOCIAL_REVIEW_CANDIDATES_PATH=review_candidates.json
# HTTP_RESPONSE_CACHE_PATH=.http_response_cache.json
# APPROVED_HOMEPAGE_REDIRECTS=
SOCIAL_CHECK_INTERVAL_HOURS=24
SOCIAL_CHECK_LANGUAGES=DE,FR,IT,RM